-- ÖZEL RENKLİ AURA & HIGHLIGHT SİSTEMİ
--------------------------------------------------------------------------------
local highlightInstance = nil
local auraParticles = {}

local colorList = {
    {name = "MAVİ", color = Color3.fromRGB(0, 120, 255)},
    {name = "KIRMIZI", color = Color3.fromRGB(255, 40, 40)},
    {name = "YEŞİL", color = Color3.fromRGB(40, 255, 90)},
    {name = "MOR", color = Color3.fromRGB(170, 50, 255)},
    {name = "SARI", color = Color3.fromRGB(255, 220, 0)}
}
local colorIndex = 1

local function updateAuraVisuals()
    if not auraActive then return end
    local char = player.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")

    if highlightInstance then
        highlightInstance.FillColor = currentCustomColor
        highlightInstance.OutlineColor = Color3.new(
            math.min(currentCustomColor.R + 0.3, 1),
            math.min(currentCustomColor.G + 0.3, 1),
            math.min(currentCustomColor.B + 0.3, 1)
        )
    end

    for _, att in ipairs(auraParticles) do
        for _, child in ipairs(att:GetChildren()) do
            if child:IsA("ParticleEmitter") then
                child.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, currentCustomColor),
                    ColorSequenceKeypoint.new(0.5, Color3.new(
                        math.min(currentCustomColor.R + 0.4, 1),
                        math.min(currentCustomColor.G + 0.4, 1),
                        math.min(currentCustomColor.B + 0.4, 1)
                    )),
                    ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 20))
                })
            end
        end
    end
end

local function toggleAura()
    auraActive = not auraActive
    local char = player.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")

    if auraActive then
        auraButton.Text = "ÖZEL AURA: ON"
        TweenService:Create(auraButton, TweenInfo.new(0.2), {BackgroundColor3 = currentCustomColor}):Play()

        if char then
            highlightInstance = Instance.new("Highlight")
            highlightInstance.Name = "CustomHighlight"
            highlightInstance.Adornee = char
            highlightInstance.FillColor = currentCustomColor
            highlightInstance.FillTransparency = 0.6
            highlightInstance.OutlineColor = Color3.new(1,1,1)
            highlightInstance.OutlineTransparency = 0.1
            highlightInstance.Parent = char

            if rootPart then
                for i = 1, 2 do
                    local attachment = Instance.new("Attachment")
                    attachment.Name = "FlameAttachment" .. i
                    attachment.Position = Vector3.new(math.random(-1, 1), -2, math.random(-1, 1))
                    attachment.Parent = rootPart

                    local fire = Instance.new("ParticleEmitter")
                    fire.Name = "FireParticle"
                    fire.Lifetime = NumberRange.new(0.6, 1.2)
                    fire.Rate = 25
                    fire.Speed = NumberRange.new(4, 7)
                    fire.SpreadAngle = Vector2.new(15, 15)
                    fire.Acceleration = Vector3.new(0, 5, 0)
                    fire.Parent = attachment

                    table.insert(auraParticles, attachment)
                end
            end
            updateAuraVisuals()
        end
    else
        auraButton.Text = "ÖZEL AURA: OFF"
        TweenService:Create(auraButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(65, 100, 220)}):Play()

        if highlightInstance then
            highlightInstance:Destroy()
            highlightInstance = nil
        end

        for _, att in ipairs(auraParticles) do
            if att then att:Destroy() end
        end
        auraParticles = {}
    end
end

colorButton.MouseButton1Click:Connect(function()
    playSound(BUTTON_SOUND, 0.6)
    colorIndex = colorIndex + 1
    if colorIndex > #colorList then colorIndex = 1 end
    
    currentCustomColor = colorList[colorIndex].color
    colorButton.Text = "RENK DEĞİŞTİR (" .. colorList[colorIndex].name .. ")"
    updateAuraVisuals()
end)

