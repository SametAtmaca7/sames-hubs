local function toggleNoclip()
    noclipActive = not noclipActive
    if noclipActive then
        noclipButton.Text = "NOCLIP: ON"
        TweenService:Create(noclipButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 160, 90)}):Play()
        noclipConnection = RunService.Stepped:Connect(function()
            local char = player.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)
    else
        noclipButton.Text = "NOCLIP: OFF"
        TweenService:Create(noclipButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(65, 100, 220)}):Play()
        if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    end
end

local function toggleSuperJump()
    superJumpActive = not superJumpActive
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if superJumpActive then
        jumpButton.Text = "SUPER JUMP: ON"
        TweenService:Create(jumpButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 160, 90)}):Play()
        if hum then hum.JumpPower = 150 end
    else
        jumpButton.Text = "SUPER JUMP: OFF"
        TweenService:Create(jumpButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(65, 100, 220)}):Play()
        if hum then hum.JumpPower = 50 end
    end
end

local function toggleSpeedBoost()
